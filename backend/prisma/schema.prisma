generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CUSTOMER
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FAILED
  CANCELLED
  COMPLETED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  refreshTokenHash String?
  fullName     String
  role         UserRole    @default(CUSTOMER)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orders       Order[]
  auditLogs    AuditLog[]
  pages        PageVersion[]
  accessLogs   AccessLog[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  images      Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   @db.LongText
  status      String   @default("DRAFT")
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  categories  PostCategoryMap[]
  tags        PostTagMap[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  items     Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @db.Decimal(10, 2)
  paymentRef    String?
  paymentMethod String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model Media {
  id            String   @id @default(cuid())
  publicId      String   @unique
  secureUrl     String
  resourceType  String
  format        String
  width         Int
  height        Int
  bytes         Int
  folder        String
  altText       String?
  ownerType     String
  ownerId       String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Page {
  id        String       @id @default(cuid())
  slug      String       @unique
  status    PageStatus   @default(DRAFT)
  themeId   String?
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  versions  PageVersion[]
}

model PageVersion {
  id         String   @id @default(cuid())
  pageId     String
  jsonSchema Json
  createdBy  String?
  createdAt  DateTime @default(now())
  page       Page     @relation(fields: [pageId], references: [id])
  user       User?    @relation(fields: [createdBy], references: [id])
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  note       String?
  changedBy  String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
}

model PostCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  posts     PostCategoryMap[]
}

model PostTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  posts     PostTagMap[]
}

model PostCategoryMap {
  postId     String
  categoryId String
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model PostTagMap {
  postId String
  tagId  String
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  ipAddress String?
  device    String?
  route     String
  method    String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
